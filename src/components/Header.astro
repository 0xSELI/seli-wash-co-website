---
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/#services', label: 'Services' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="head" data-header>
  <div class="wrap head-row">
    <Wordmark href="/" />
    <a class="btn btn-primary head-cta" href="/contact#estimate">Free estimate</a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" type="button">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg><span>Menu</span>
    </button>
    <nav class="nav" id="primary-nav" aria-label="Primary">
      {nav.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('.nav');
  if (header && toggle && menu) {
    const close = () => toggle.setAttribute('aria-expanded', 'false');
    toggle.addEventListener('click', () => toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true')));
    menu.addEventListener('click', event => { if ((event.target as Element).closest('a')) close(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
    document.addEventListener('click', event => { if (!header.contains(event.target as Node)) close(); });
    header.addEventListener('focusout', event => { if (!header.contains(event.relatedTarget as Node)) close(); });
    new ResizeObserver(() => document.documentElement.style.setProperty('--anchor-offset', `${header.offsetHeight + 20}px`)).observe(header);
    window.matchMedia('(min-width: 901px)').addEventListener('change', close);
    header.dataset.navigationReady = 'true';
  }
</script>
<style>
  .head { position:sticky; top:0; z-index:60; background:var(--ink); border-bottom:1px solid var(--hair-dark); }
  .head-row { display:flex; align-items:center; gap:clamp(.8rem,2vw,2rem); padding-block:.6rem; }
  .head :global(.mark) { margin-right:auto; flex-shrink:0; }
  .nav { display:flex; gap:clamp(.8rem,1.5vw,1.5rem); align-items:center; order:1; }
  .nav a { display:flex; min-height:44px; align-items:center; color:var(--slate-ltr); font-size:.95rem; text-decoration:none; border-bottom:2px solid transparent; }
  .nav a:hover,.nav a[aria-current] { color:var(--paper); border-color:var(--amber); }
  .head-cta { order:2; padding:.7rem 1.1rem; white-space:nowrap; }
  .menu-toggle { display:none; }
  @media (max-width:1100px) { .head :global(.brand-name) { display:none; } }
  @media (max-width:900px) {
    .head-row { gap:.65rem; flex-wrap:wrap; padding-block:.4rem; }
    .head :global(.mark-logo) { width:56px; height:56px; }
    .head-cta { order:1; font-size:.9rem; padding:.65rem .85rem; }
    .menu-toggle { order:2; display:flex; gap:.3rem; align-items:center; justify-content:center; min-height:48px; padding:.5rem; color:var(--paper); background:none; border:1px solid var(--hair-dark); border-radius:6px; font:inherit; font-size:.85rem; cursor:pointer; }
    .nav { display:none; position:absolute; top:100%; left:0; right:0; padding:1rem var(--gut) 1.4rem; background:var(--ink); border-bottom:1px solid var(--hair-dark); max-height:calc(100dvh - 170px); overflow-y:auto; }
    .menu-toggle[aria-expanded='true'] + .nav { display:flex; flex-direction:column; align-items:stretch; }
    .nav a { min-height:52px; border-bottom:1px solid var(--hair-dark); font-size:1.1rem; }
    .head:not([data-navigation-ready]) .nav { position:static; display:flex; flex-basis:100%; flex-wrap:wrap; padding:0; gap:.5rem 1rem; }
    .head:not([data-navigation-ready]) .menu-toggle { display:none; }
  }
</style>
