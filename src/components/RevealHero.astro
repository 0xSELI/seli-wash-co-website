---
import { business, sms } from '../data/business';
import Waterline from './Waterline.astro';
---
<section class="opening" aria-labelledby="hero-heading">
  <div class="wrap opening-grid">
    <div class="hero-copy">
      <h1 class="display" id="hero-heading">Concrete cleaning.<br /><em>A fresh start.</em></h1>
      <p class="lede">Driveways, sidewalks, patios and porches in {business.area.label}.</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href="/contact#estimate">Get a free estimate</a>
        <a class="text-action" href={sms}>Text us</a>
      </div>
      <p class="hero-note">A price agreed before the work begins.</p>
    </div>
    <figure class="comparison">
      <div class="hero" data-hero>
        <img class="surface surface-clean" src="/img/concrete-clean.jpg" alt="" width="1500" height="1000" fetchpriority="high" decoding="async" data-surface="clean" />
        <img class="surface surface-dirty" src="/img/concrete-dirty.jpg" alt="" width="1500" height="1000" fetchpriority="high" decoding="async" data-surface="dirty" />
        <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
        <div class="front" data-front aria-hidden="true"></div>
        <input class="reveal-input" type="range" min="0" max="100" value="63" step="0.1" aria-label="Compare weathered and clean concrete textures" aria-describedby="texture-caption" data-reveal-input />
        <span class="handle" data-handle aria-hidden="true"><svg viewBox="0 0 32 24" width="30" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="m11 6-6 6 6 6M21 6l6 6-6 6M5 12h22" /></svg></span>
        <span class="drag-hint" data-hint aria-hidden="true">Drag the wash line</span>
        <div class="hero-tags" aria-hidden="true"><span class="tag">Weathered</span><span class="tag">Clean</span></div>
      </div>
      <figcaption id="texture-caption">Texture illustration, not a completed project. Drag to compare.</figcaption>
    </figure>
  </div>
  <Waterline />
</section>
<script>import '../scripts/hero-reveal';</script>
<style>
  .opening { background: var(--ink); color: var(--paper); position: relative; }
  .opening-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-top: clamp(2.5rem, 5vw, 4.5rem); padding-bottom: 2.5rem; }
  .hero-copy h1 { font-size: clamp(2.5rem, 4.5vw, 4.5rem); line-height: 1.04; letter-spacing: -.035em; text-wrap: initial; }
  .hero-copy em { font-style: normal; color: var(--wet); }
  .lede { margin-block: 1.6rem; max-width: 34ch; color: var(--slate-ltr); }
  .actions { align-items: center; gap: 1rem 1.5rem; }
  .hero-note { font-size: var(--s2); color: var(--slate-lt); margin-top: 1.15rem; }
  .comparison { margin: 0; min-width: 0; }
  figcaption { color: var(--slate-ltr); font-size: .875rem; margin-top: .8rem; text-align: right; }
  .hero { position: relative; height: clamp(350px, 36vw, 510px); isolation: isolate; overflow: hidden; border: 1px solid var(--wet); border-radius: 12px; background: var(--ink-2); }
  .surface,.hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .surface-dirty { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .hero-canvas { opacity: 0; pointer-events: none; z-index: 1; transition: opacity .4s var(--ease); }
  .hero[data-webgl='on'] .hero-canvas { opacity: 1; }
  .hero[data-webgl='on'] .surface,.hero[data-webgl='on'] .front { visibility: hidden; }
  .front { position: absolute; inset-block: 0; left: var(--pos); width: 3px; z-index: 2; background: var(--wet); box-shadow: 0 0 22px 5px #bfe6f273; pointer-events: none; }
  .front::after { content: ''; position: absolute; inset: 0 auto 0 3px; width: 40px; background: linear-gradient(90deg,#bfe6f24d,transparent); }
  .reveal-input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; z-index: 4; appearance: none; background: transparent; cursor: ew-resize; touch-action: pan-y; }
  .reveal-input::-webkit-slider-runnable-track { height: 100%; background: transparent; }
  .reveal-input::-moz-range-track { height: 100%; background: transparent; }
  .reveal-input::-webkit-slider-thumb { appearance: none; width: 56px; height: 56px; background: transparent; border: 0; }
  .reveal-input::-moz-range-thumb { width: 56px; height: 56px; background: transparent; border: 0; }
  .reveal-input:focus-visible { outline: 0; }
  .handle { position: absolute; top: 50%; left: clamp(29px, var(--pos), calc(100% - 29px)); transform: translate(-50%,-50%); z-index: 5; pointer-events: none; width: 56px; height: 56px; display: grid; place-items: center; border: 3px solid var(--wet); border-radius: 50%; background: var(--paper); color: var(--ink); box-shadow: 0 4px 24px #07111c66; }
  .reveal-input:focus-visible + .handle { outline: 3px solid var(--amber); outline-offset: 4px; }
  .drag-hint { position: absolute; top: calc(50% + 44px); left: 50%; transform: translateX(-50%); z-index: 5; pointer-events: none; padding: .35rem .65rem; background: var(--ink); color: var(--wet); font-size: .75rem; border-radius: 4px; white-space: nowrap; }
  [data-interacted] .drag-hint { opacity: 0; }
  .hero-tags { position: absolute; inset: auto 1rem 1rem; display: flex; justify-content: space-between; pointer-events: none; z-index: 5; }
  .hero:not([data-reveal-ready]) .reveal-input,.hero:not([data-reveal-ready]) .handle,.hero:not([data-reveal-ready]) .drag-hint { display: none; }
  @media(max-width:820px) {
    .opening-grid { grid-template-columns: 1fr; gap: 1.8rem; padding-top: 2rem; padding-bottom: 1rem; }
    .hero-copy { max-width: 620px; }
    .hero-copy h1 { font-size: clamp(2.3rem, 7vw, 3.7rem); }
    .lede { margin-block: 1.1rem; font-size: 1rem; max-width: 42ch; }
    .hero-note { margin-top: .75rem; }
    .hero { height: clamp(235px, 55vw, 350px); }
    figcaption { text-align: left; }
    .drag-hint { top: calc(50% - 72px); }
  }
  @media(max-width:380px) { .hero-copy h1 { font-size: 2.15rem; } .actions { gap: .5rem 1rem; } .actions .btn { padding-inline: 1rem; } }
</style>
