---
import { business, sms } from '../data/business';
import Waterline from './Waterline.astro';

interface Props {
  heading?: string;
}
const { heading = 'Ready for a fresh start?' } = Astro.props;
---

<div class="wave-cap"><Waterline filled /></div>
<section class="closer">
  <div class="wrap">
    <div>
      <h2 class="display">{heading}</h2>
      <p>
        Send your address, the surface, and a photo if you have one.
        We’ll talk through the job and give you a free estimate.
      </p>
    </div>
    <div class="actions">
      <a class="btn btn-dark btn-lg" href="/contact#estimate">
        Get a free estimate
      </a>
      <a class="btn btn-lg closer-alt" href={sms}>
        Text {business.phone.display}
      </a>
    </div>
  </div>
</section>

<style>
  .closer {
    background: var(--wet);
    color: var(--ink);
  }
  .closer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 2.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(2.75rem, 5vw, 4rem);
  }
  .closer h2 {
    font-size: clamp(1.9rem, 3.8vw, var(--s7));
    max-width: 18ch;
    line-height: 1.05;
  }
  .closer p {
    margin-top: 0.6rem;
    max-width: 46ch;
    color: var(--slate-dk);
    font-size: var(--s2);
  }
  .closer-alt {
    background: transparent;
    color: var(--amber-ink);
    border-color: rgba(26, 18, 6, 0.4);
  }
  .closer-alt:hover {
    border-color: var(--amber-ink);
    background: rgba(255, 255, 255, 0.25);
  }
  @media (max-width: 820px) {
    .closer .wrap {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .wave-cap { background: var(--paper); }
  .closer .wrap { padding-top: 1.5rem; }
  .closer-alt { color: var(--ink); border: 0; text-decoration: underline; text-underline-offset: 5px; padding-inline: .2rem; }
</style>
