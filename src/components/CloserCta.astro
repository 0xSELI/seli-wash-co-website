---
import { business, sms } from '../data/business';

interface Props {
  heading?: string;
}
const { heading = 'Find out what it costs.' } = Astro.props;
---

<section class="closer">
  <div class="wrap">
    <div>
      <h2 class="display">{heading}</h2>
      <p>
        Estimates are free and there is no obligation. Texting is the quickest
        way to reach us. We will need an outdoor spigot and a working outdoor
        GFCI outlet within about {business.equipment.hoseFeet} feet of the area.
      </p>
    </div>
    <div class="actions">
      <a class="btn btn-dark btn-lg" href="/contact#estimate">
        Request a free estimate
      </a>
      <a class="btn btn-lg closer-alt" href={sms}>
        Text {business.phone.display}
      </a>
    </div>
  </div>
</section>

<style>
  .closer {
    background: var(--amber);
    color: var(--amber-ink);
  }
  .closer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 2.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(2.75rem, 5vw, 4rem);
  }
  .closer h2 {
    font-size: clamp(1.9rem, 3.8vw, var(--s7));
    max-width: 18ch;
    line-height: 1.05;
  }
  .closer p {
    margin-top: 0.6rem;
    max-width: 46ch;
    color: #513a15;
    font-size: var(--s2);
  }
  .closer-alt {
    background: transparent;
    color: var(--amber-ink);
    border-color: rgba(26, 18, 6, 0.4);
  }
  .closer-alt:hover {
    border-color: var(--amber-ink);
    background: rgba(255, 255, 255, 0.25);
  }
  @media (max-width: 820px) {
    .closer .wrap {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
