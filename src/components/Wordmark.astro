---
interface Props {
  href?: string;
  /** Suppress the link when the wordmark is already inside one. */
  plain?: boolean;
}
const { href = '/', plain = false } = Astro.props;
const Tag = plain ? 'span' : 'a';
---

<Tag class="mark" {...plain ? {} : { href }}>
  <img
    class="mark-logo"
    src="/brand/seli-wash-logo-site.png"
    alt="SELI Wash Co."
    width="68"
    height="68"
    decoding="async"
  />
</Tag>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    color: var(--paper);
    text-decoration: none;
  }
  .mark-logo {
    width: 68px;
    height: 68px;
    flex: none;
    object-fit: contain;
  }
  @media (max-width: 420px) {
    .mark-logo {
      width: 52px;
      height: 52px;
    }
  }
</style>
