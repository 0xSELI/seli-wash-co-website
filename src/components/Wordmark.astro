---
interface Props {
  href?: string;
  /** Suppress the link when the wordmark is already inside one. */
  plain?: boolean;
}
const { href = '/', plain = false } = Astro.props;
const Tag = plain ? 'span' : 'a';
---

<Tag class="mark" {...plain ? {} : { href }}>
  <img
    class="mark-logo"
    src="/brand/seli-pressure-washing-logo-site.png?v=3"
    alt="SELI Pressure Washing"
    width="68"
    height="68"
    decoding="async"
  />
  <span class="brand-name" aria-hidden="true">SELI<span>Pressure Washing</span></span>
</Tag>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    color: var(--paper);
    text-decoration: none;
    gap: .65rem;
  }
  .brand-name { font-family: var(--display); font-size: 1.35rem; font-weight: 650; letter-spacing: .05em; line-height: 1.2; }
  .brand-name span { display: block; font-size: .68rem; color: var(--wet); letter-spacing: .06em; }
  .mark-logo {
    width: 68px;
    height: 68px;
    flex: none;
    object-fit: contain;
  }
  @media (max-width: 420px) {
    .mark-logo {
      width: 52px;
      height: 52px;
    }
  }
  @media (max-width: 360px) { .brand-name { display: none; } }
</style>
