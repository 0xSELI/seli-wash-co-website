---
import { business } from '../data/business';

/*
 * There is no logo, and this is a deliberate typographic wordmark rather than a
 * stand-in for one. The glyph is the wash front: soiled navy on one side, clean
 * white on the other, with the wet light between them.
 */

interface Props {
  href?: string;
  /** Suppress the link when the wordmark is already inside one. */
  plain?: boolean;
}
const { href = '/', plain = false } = Astro.props;
const Tag = plain ? 'span' : 'a';
---

<Tag class="mark" {...plain ? {} : { href }}>
  <span class="mark-glyph" aria-hidden="true"></span>
  <span class="mark-name">
    {business.nameParts.lead}<em>&nbsp;{business.nameParts.rest}</em>
  </span>
</Tag>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--paper);
    text-decoration: none;
  }
  .mark-glyph {
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: var(--radius-sm);
    background: linear-gradient(
      105deg,
      var(--ink-3) 0%,
      var(--ink-3) 44%,
      var(--wet) 46%,
      var(--wet) 49%,
      var(--paper) 51%,
      var(--paper) 100%
    );
  }
  .mark-name {
    font-family: var(--display);
    font-size: var(--s4);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .mark-name em {
    font-style: normal;
    color: var(--amber);
  }
</style>
