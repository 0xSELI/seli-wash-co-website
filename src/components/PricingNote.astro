---
import { business, quoteFactorSentence } from '../data/business';

/**
 * Driveway pricing is owner-confirmed. It is kept in business.ts so the
 * displayed formula and calculator cannot drift from one another.
 */
---

<div class="note">
  <p class="eyebrow">Introductory Pricing</p>
  <p class="min">
    $100 covers up to 900 sq. ft. of residential driveway
  </p>
  <p>
    For driveways over 900 sq. ft., add $0.12 for every additional square foot.
    This introductory pricing is for the first {business.pricing.drivewayIntroductory.customerLimit}{' '}
    residential driveway customers.
  </p>
  <p>
    Heavy oil, rust, paint, or unusually severe staining may cost extra after
    inspection. Every estimate is free; {quoteFactorSentence()} can still
    affect the final quote.
  </p>
  <p>
    A ${business.pricing.standaloneMinimum} minimum still applies to other
    eligible standalone appointments. Outside the {business.area.city} service
    area, travel is ${business.area.travelChargePerMile} per additional mile.
  </p>
</div>

<style>
  .note {
    border-left: 4px solid var(--amber);
    background: var(--mist);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.4rem clamp(1.1rem, 2vw, 1.75rem);
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 80ch;
  }
  .note .eyebrow {
    color: var(--amber-deep);
  }
  .note .min {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, var(--s6));
    color: var(--ink);
    letter-spacing: 0.01em;
    line-height: 1.1;
  }
  .note p:not(.eyebrow):not(.min) {
    color: var(--slate-dk);
    font-size: var(--s2);
    max-width: 72ch;
  }
  /* On the ink band the same component needs the light text set. */
  :global(.band-ink) .note {
    background: var(--ink-2);
  }
  :global(.band-ink) .note .min {
    color: var(--paper);
  }
  :global(.band-ink) .note p:not(.eyebrow):not(.min) {
    color: var(--slate-ltr);
  }
</style>
