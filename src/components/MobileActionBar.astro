---
import { tel, sms } from '../data/business';
---

<!--
  Docked call / text / estimate actions. Text sits in the middle and is marked
  as preferred; the amber stays on the estimate because amber means "the
  primary action" everywhere else on the site and should not shift meaning here.
-->
<div class="actionbar">
  <a class="btn btn-ghost" href={tel}>Call</a>
  <a class="btn btn-ghost text-pref" href={sms}>
    Text<span class="pref" aria-hidden="true">preferred</span>
    <span class="visually-hidden">— preferred contact method</span>
  </a>
  <a class="btn btn-primary" href="/contact#estimate">Estimate</a>
</div>

<style>
  .actionbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 70;
    display: none;
    gap: 0.6rem;
    padding: 0.65rem;
    padding-bottom: calc(0.65rem + env(safe-area-inset-bottom));
    background: rgba(11, 24, 38, 0.97);
    border-top: 1px solid var(--hair-dark);
  }
  .actionbar .btn {
    flex: 1;
    /* 44px minimum touch target, and all three stay the same size. */
    min-height: 48px;
    padding: 0.75rem 0.4rem;
    font-size: var(--s2);
  }
  .text-pref {
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.1;
  }
  .pref {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--wet);
  }
  @media (max-width: 820px) {
    .actionbar {
      display: flex;
    }
  }
</style>
