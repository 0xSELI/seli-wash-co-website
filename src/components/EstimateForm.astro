---
import { business, sms, mailto } from '../data/business';
import { services } from '../data/services';
// The workflow is a text-message handoff by design; see src/lib/estimate/README.md.

/**
 * The estimate request form.
 *
 * It is a REQUEST, not a booking. Nothing here reserves a slot, confirms a
 * time, or promises when a reply will come — no response time has been set.
 *
 * The form carries a honeypot field and a dwell-time check. Neither is
 * described in the markup, because explaining an anti-spam trap in delivered
 * HTML is a good way to make it useless. The honeypot is positioned off-screen
 * rather than display:none so it stays fillable by bots while never being
 * announced to or focusable by real users.
 *
 * The qualifying questions are load-bearing rather than decorative: the owner
 * works from a 25 ft hose and a 25 ft cord off the customer's own spigot and
 * GFCI outlet, so a property without them may simply not be workable. Answering
 * "no" or "not sure" does not block the form — it surfaces an honest advisory
 * and still lets the request through, because that conversation is cheaper to
 * have by text than by driving over.
 */

const timings = [
  'No preference',
  'Next available Tuesday',
  'Next available Thursday',
  'A weekend, if possible',
  'I need to discuss timing',
];
---

<section class="estimate" id="estimate" aria-labelledby="estimate-heading">
  <div class="estimate-head">
    <p class="eyebrow">Request a free estimate</p>
    <h2 class="display" id="estimate-heading">
      Tell us what needs cleaning.
    </h2>
    <p class="lede">
      Add the details below and we will prepare a text message for you to review
      and send. It starts a conversation — it does not book a time automatically.
    </p>
  </div>

  <p class="how-it-works" role="note">
    <strong>How it works:</strong> we check that the important details are
    included, then open your messaging app with the request written out. You
    review it, attach any photos, and send it when you are ready.
  </p>

  <!-- Error summary. Focus lands here on a failed submit so keyboard and
       screen reader users are told what went wrong before anything else. -->
  <div
    class="summary"
    data-error-summary
    role="alert"
    tabindex="-1"
    hidden
  >
    <p class="summary-title">
      <strong data-error-count></strong> to fix before we can write your message:
    </p>
    <ul data-error-list></ul>
  </div>

  <form class="form" data-estimate-form novalidate>
    <div class="aux-field" aria-hidden="true">
      <label for="company-website">Company website</label>
      <input id="company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <fieldset>
      <legend>How to reach you</legend>

      <div class="field">
        <label for="name">Your name <span class="req">required</span></label>
        <input id="name" name="name" type="text" autocomplete="name" required aria-required="true" />
        <p class="err" data-err-for="name" hidden></p>
      </div>

      <div class="row">
        <div class="field">
          <label for="phone">Mobile number</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            aria-describedby="phone-hint"
          />
          <p class="hint" id="phone-hint">Best for texting photos back and forth.</p>
          <p class="err" data-err-for="phone" hidden></p>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" />
          <p class="err" data-err-for="email" hidden></p>
        </div>
      </div>
      <p class="hint hint-standalone" id="contact-hint">
        Give us at least one of the two, whichever you would rather we used.
      </p>

      <fieldset class="inner">
        <legend>How should we reply?</legend>
        <div class="choices">
          <label class="choice">
            <input type="radio" name="contactPreference" value="text" checked />
            <span>Text <em>preferred</em></span>
          </label>
          <label class="choice">
            <input type="radio" name="contactPreference" value="call" />
            <span>Call</span>
          </label>
          <label class="choice">
            <input type="radio" name="contactPreference" value="email" />
            <span>Email</span>
          </label>
        </div>
        <p class="err" data-err-for="contactPreference" hidden></p>
      </fieldset>
    </fieldset>

    <fieldset>
      <legend>The property</legend>

      <div class="field">
        <label for="address">Street address <span class="req">required</span></label>
        <input
          id="address"
          name="address"
          type="text"
          autocomplete="street-address"
          required
          aria-required="true"
        />
        <p class="err" data-err-for="address" hidden></p>
      </div>

      <div class="field">
        <label for="cityOrZip">Town or ZIP <span class="req">required</span></label>
        <input
          id="cityOrZip"
          name="cityOrZip"
          type="text"
          autocomplete="postal-code"
          required
          aria-required="true"
          aria-describedby="area-hint"
        />
        <p class="hint" id="area-hint">
          We are based in {business.area.label}. Outside Duncan we will still
          consider the job — travel is ${business.area.travelChargePerMile} per
          additional mile, and it goes in the quote before you approve it.
        </p>
        <p class="err" data-err-for="cityOrZip" hidden></p>
      </div>
    </fieldset>

    <fieldset>
      <legend>What needs cleaning <span class="req">required</span></legend>
      <p class="hint hint-standalone" id="services-hint">Pick everything that applies.</p>
      <div class="choices choices-stack" role="group" aria-describedby="services-hint">
        {
          services.map((s) => (
            <label class="choice">
              <input type="checkbox" name="services" value={s.slug} />
              <span>
                {s.name} <em>{s.price}</em>
              </span>
            </label>
          ))
        }
      </div>
      <p class="err" data-err-for="services" hidden></p>

      <div class="field field-conditional" data-steps-field>
        <label for="stepCount">How many steps?</label>
        <input
          id="stepCount"
          name="stepCount"
          type="number"
          min="1"
          max="200"
          inputmode="numeric"
          aria-describedby="steps-hint"
        />
        <p class="hint" id="steps-hint">
          Steps are $10 each when added to another service on the same visit.
          On their own, fewer than five steps still comes to the $
          {business.pricing.standaloneMinimum} standalone minimum.
        </p>
        <p class="err" data-err-for="stepCount" hidden></p>
      </div>

      <div class="field">
        <label for="approximateSize">Rough size, if you know it</label>
        <input
          id="approximateSize"
          name="approximateSize"
          type="text"
          aria-describedby="size-hint"
        />
        <p class="hint" id="size-hint">
          Anything helps — "two-car driveway", "about 40 feet of path". A guess
          is fine; we confirm on site.
        </p>
      </div>

      <div class="field">
        <label for="timing">When suits you?</label>
        <select id="timing" name="timing" aria-describedby="timing-hint">
          {timings.map((t) => <option value={t}>{t}</option>)}
        </select>
        <p class="hint" id="timing-hint">
          {business.hours.work}. {business.hours.weekends}. Choosing here does
          not hold a slot — we confirm every request by hand.
        </p>
      </div>
    </fieldset>

    <fieldset>
      <legend>Water and power</legend>
      <p class="hint hint-standalone">
        {business.equipment.reachSummary} If it turns out we cannot reach
        safely, we will tell you rather than guess.
      </p>

      <div class="qualifiers">
        <fieldset class="inner">
          <legend>Is there an outdoor water spigot?</legend>
          <div class="choices">
            <label class="choice"><input type="radio" name="hasSpigot" value="yes" /><span>Yes</span></label>
            <label class="choice"><input type="radio" name="hasSpigot" value="no" /><span>No</span></label>
            <label class="choice"><input type="radio" name="hasSpigot" value="unsure" /><span>Not sure</span></label>
          </div>
          <p class="err" data-err-for="hasSpigot" hidden></p>
        </fieldset>

        <fieldset class="inner">
          <legend>Is there an outdoor GFCI-protected outlet?</legend>
          <div class="choices">
            <label class="choice"><input type="radio" name="hasGfciOutlet" value="yes" /><span>Yes</span></label>
            <label class="choice"><input type="radio" name="hasGfciOutlet" value="no" /><span>No</span></label>
            <label class="choice"><input type="radio" name="hasGfciOutlet" value="unsure" /><span>Not sure</span></label>
          </div>
          <p class="hint">
            Usually the outdoor socket with a test and reset button on it. Not
            sure is a perfectly good answer.
          </p>
          <p class="err" data-err-for="hasGfciOutlet" hidden></p>
        </fieldset>

        <fieldset class="inner">
          <legend>
            Is the area within about {business.equipment.hoseFeet} feet of both?
          </legend>
          <div class="choices">
            <label class="choice"><input type="radio" name="withinReach" value="yes" /><span>Yes</span></label>
            <label class="choice"><input type="radio" name="withinReach" value="no" /><span>No</span></label>
            <label class="choice"><input type="radio" name="withinReach" value="unsure" /><span>Not sure</span></label>
          </div>
          <p class="err" data-err-for="withinReach" hidden></p>
        </fieldset>
      </div>

      <!-- Advisory, not an error. Populated by script when an answer suggests
           the job may not be reachable. -->
      <p class="advisory" data-reach-advisory role="status" hidden></p>
    </fieldset>

    <fieldset>
      <legend>Photos <span class="opt">optional</span></legend>
      <p class="hint hint-standalone" id="photo-hint">
        A couple of pictures of the surface make the estimate much more
        accurate. Up to 5 images, 8 MB each.
      </p>

      <div class="field">
        <label class="file-label" for="photos">
          <span class="btn btn-outline">Choose photos</span>
          <span class="file-count" data-file-count>No photos chosen</span>
        </label>
        <input
          id="photos"
          name="photos"
          type="file"
          accept="image/*"
          multiple
          class="visually-hidden"
          aria-describedby="photo-hint"
        />
        <ul class="file-list" data-file-list></ul>
        <p class="err" data-err-for="photos" hidden></p>
      </div>

      <p class="advisory" role="note">
        Photos are attached in your messaging app, not uploaded here. Choosing
        them now just lists their names in the message so you know which ones to
        add.
      </p>
    </fieldset>

    <fieldset>
      <legend>Anything else</legend>
      <div class="field">
        <label for="notes">Notes</label>
        <textarea
          id="notes"
          name="notes"
          rows="4"
          aria-describedby="notes-hint"
        ></textarea>
        <p class="hint" id="notes-hint">
          Stains you are worried about, gate codes, a dog in the yard, awkward
          access — anything that changes how the job goes.
        </p>
      </div>
    </fieldset>

    <div class="field consent">
      <label class="choice">
        <input
          type="checkbox"
          name="contactConsent"
          required
          aria-required="true"
        />
        <span>
          {business.name} can contact me {business.legal.consentScope}.
          <span class="req">required</span>
        </span>
      </label>
      <p class="hint">
        That is the only thing this covers — no marketing texts, no mailing
        list. See <a class="inline-link" href="/privacy">Privacy</a>.
      </p>
      <p class="err" data-err-for="contactConsent" hidden></p>
    </div>

    <div class="submit-row">
      <button class="btn btn-primary btn-lg" type="submit" data-submit>
        Prepare text request
      </button>
      <a class="btn btn-outline btn-lg" href={sms}>Start a blank text</a>
    </div>

    <!-- Live region for submit outcome. Kept outside the button so a screen
         reader announces the result rather than a label change. -->
    <div class="result" data-result role="status" aria-live="polite" hidden></div>
  </form>

  <p class="disclaim form-foot">
    Prices on this site are introductory starting points, not quotes. There is a
    ${business.pricing.standaloneMinimum} minimum on standalone appointments.
    Email <a class="inline-link" href={mailto}>{business.email}</a> if you would
    rather write.
  </p>
</section>

<script>
  import '../scripts/estimate-form';
</script>

<style>
  .estimate {
    scroll-margin-top: 120px;
  }
  .estimate-head {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: 2rem;
  }
  .estimate-head .eyebrow {
    color: var(--amber-deep);
  }
  .estimate-head h2 {
    font-size: clamp(1.9rem, 3.6vw, var(--s7));
    color: var(--ink);
  }
  .estimate-head .lede {
    color: var(--slate);
  }
  .inline-link {
    color: var(--amber-deep);
    font-weight: 600;
  }

  .how-it-works {
    border-left: 4px solid var(--amber);
    background: #fdf4e8;
    color: #5b3d13;
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1rem 1.2rem;
    font-size: var(--s2);
    margin-bottom: 1.75rem;
    max-width: 72ch;
  }

  .summary {
    border-left: 4px solid var(--bad);
    background: var(--bad-bg);
    color: #6d1d17;
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1rem 1.2rem;
    margin-bottom: 1.75rem;
    max-width: 72ch;
  }
  .summary-title {
    font-size: var(--s3);
    margin-bottom: 0.4rem;
  }
  .summary ul {
    list-style: disc;
    padding-left: 1.2rem;
    font-size: var(--s2);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .summary a {
    color: inherit;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 60rem;
  }

  fieldset {
    border: 1px solid var(--hair-light);
    border-radius: var(--radius);
    padding: 1.5rem clamp(1rem, 2vw, 1.6rem);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
  }
  legend {
    font-family: var(--display);
    font-size: var(--s5);
    font-weight: 600;
    color: var(--ink);
    padding-inline: 0.4rem;
  }
  fieldset.inner {
    border-color: var(--mist-2);
    background: #fbfcfd;
    padding: 1rem 1.1rem;
    gap: 0.6rem;
  }
  fieldset.inner legend {
    font-size: var(--s3);
    letter-spacing: 0.01em;
  }

  .qualifiers {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .row {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  label {
    font-weight: 600;
    color: var(--slate-dk);
    font-size: var(--s3);
  }
  .req,
  .opt {
    font-family: var(--display);
    font-size: var(--s1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-left: 0.4rem;
  }
  .req {
    color: var(--amber-deep);
  }
  .opt {
    color: var(--slate);
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  input[type='number'],
  select,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid #b9c4d0;
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.8rem;
    width: 100%;
    /* 16px minimum stops iOS zooming the viewport on focus. */
    font-size: max(1rem, var(--s3));
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--ink);
  }
  input[aria-invalid='true'],
  select[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--bad);
    background: var(--bad-bg);
  }

  .hint {
    font-size: var(--s2);
    color: var(--slate);
    max-width: 62ch;
  }
  .hint-standalone {
    margin-top: -0.3rem;
  }

  .err {
    font-size: var(--s2);
    font-weight: 600;
    color: var(--bad);
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .choices-stack {
    flex-direction: column;
    gap: 0.6rem;
  }
  .choice {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-weight: 400;
    /* Comfortable touch target without visually inflating the row. */
    padding: 0.3rem 0;
    cursor: pointer;
  }
  .choice input {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.15rem 0 0;
    flex: none;
    accent-color: var(--amber-deep);
  }
  .choice span em {
    font-style: normal;
    color: var(--slate);
    font-size: var(--s2);
    margin-left: 0.35rem;
  }
  .choice input[aria-invalid='true'] {
    outline: 2px solid var(--bad);
    outline-offset: 2px;
  }

  .field-conditional[hidden] {
    display: none;
  }

  .advisory {
    border-left: 4px solid var(--amber-deep);
    background: var(--mist);
    color: var(--slate-dk);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.85rem 1rem;
    font-size: var(--s2);
    max-width: 72ch;
  }
  .advisory[hidden] {
    display: none;
  }

  .file-label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    cursor: pointer;
  }
  .file-count {
    font-weight: 400;
    font-size: var(--s2);
    color: var(--slate);
  }
  /* The label wraps the visually-hidden input, so give it a visible focus ring
     when the input is focused by keyboard. */
  input[type='file']:focus-visible + .file-list,
  .file-label:focus-within .btn {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }
  .file-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--s2);
    color: var(--slate-dk);
  }
  .file-list:empty {
    display: none;
  }
  .file-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--mist);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.7rem;
  }
  .file-list .bad {
    color: var(--bad);
    font-weight: 600;
  }

  .consent {
    border: 1px solid var(--hair-light);
    border-radius: var(--radius);
    padding: 1.1rem clamp(1rem, 2vw, 1.6rem);
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  .result {
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    font-size: var(--s3);
    max-width: 72ch;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .result[hidden] {
    display: none;
  }
  .result[data-state='ready'] {
    background: var(--ok-bg);
    border-left: 4px solid var(--ok);
    color: #1d5540;
  }
  .result[data-state='error'] {
    background: var(--bad-bg);
    border-left: 4px solid var(--bad);
    color: #6d1d17;
  }
  .result strong {
    font-family: var(--display);
    font-size: var(--s5);
    letter-spacing: 0.01em;
  }
  .result :global(a.btn) {
    align-self: flex-start;
  }
  /* Sits under the button, because it describes what pressing it does not do. */
  .result :global(.result-note) {
    font-size: var(--s2);
  }

  /* Off-screen decoy input. Neutral class name on purpose. */
  .aux-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-foot {
    margin-top: 1.75rem;
  }

  @media (max-width: 560px) {
    fieldset {
      padding: 1.1rem 0.9rem;
    }
    .submit-row .btn {
      flex: 1 1 100%;
    }
  }
</style>
