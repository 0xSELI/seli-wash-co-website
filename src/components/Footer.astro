---
import Wordmark from './Wordmark.astro';
import { business, tel, sms, mailto } from '../data/business';
import { coreServices } from '../data/services';
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-brand">
      <Wordmark href="/" />
      <p class="foot-tagline">{business.tagline}</p>
      <p>{business.shortDescription}</p>
    </div>

    <div>
      <h2>Services</h2>
      <ul>
        {
          coreServices.map((s) => (
            <li>
              <a href={`/services#${s.slug}`}>{s.name}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2>Company</h2>
      <ul>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/services#how-estimates-work">How estimates work</a></li>
        <li><a href="/contact#estimate">Request an estimate</a></li>
      </ul>
    </div>

    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={sms}>Text {business.phone.display}</a></li>
        <li><a href={tel}>Call {business.phone.display}</a></li>
        <li><a href={mailto}>{business.email}</a></li>
        <li><span>{business.hours.contact}</span></li>
        <li><span>{business.hours.work}</span></li>
      </ul>
    </div>

    <div>
      <h2>Legal</h2>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
      <!--
        No legal entity is registered, so there is no "© SELI Pressure Washing LLC" or
        equivalent. A plain copyright line on the trading name is accurate.
      -->
      <p class="foot-legal">
        &copy; {new Date().getFullYear()} {business.name} {business.area.label}.
      </p>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink-deep);
    color: var(--slate-lt);
    padding-block: 3.5rem;
  }
  .foot .wrap {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0,1.3fr) repeat(2,minmax(0,1fr)) minmax(0,1.3fr);
  }
  .foot-brand {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .foot-brand :global(.mark-logo) {
    width: 76px;
    height: 76px;
  }
  .foot-brand p {
    font-size: var(--s2);
    max-width: 32ch;
  }
  .foot-tagline {
    color: var(--slate-ltr);
  }
  .foot h2 {
    font-family: var(--display);
    font-size: var(--s2);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--paper);
    margin-bottom: 0.9rem;
  }
  .foot ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .foot a,
  .foot span {
    font-size: var(--s2);
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--amber);
    text-decoration: underline;
  }
  .foot-legal {
    margin-top: 1.25rem;
    font-size: var(--s1);
    color: var(--slate-lt);
    max-width: 28ch;
  }
  .foot ul a { display:flex; align-items:center; min-height:44px; overflow-wrap:anywhere; }
  .foot .wrap>div:last-child { grid-column:1/-1; display:flex; align-items:center; gap:1rem 2rem; flex-wrap:wrap; border-top:1px solid var(--hair-dark); padding-top:1.5rem; }
  .foot .wrap>div:last-child h2 { margin:0; }
  .foot .wrap>div:last-child ul { flex-direction:row; gap:1.5rem; }
  .foot-legal { margin:0 0 0 auto; max-width:none; }
  .foot-brand :global(.brand-name) { display:none; }
  @media(max-width:900px) { .foot .wrap { grid-template-columns:repeat(2,minmax(0,1fr)); } .foot-brand { grid-column:1/-1; display:grid; grid-template-columns:76px minmax(0,1fr); column-gap:1.2rem; } .foot-brand :global(.mark) { grid-row:span 2; } .foot-brand p { max-width:50ch; } }
  @media(max-width:480px) { .foot .wrap>div:nth-child(4) { grid-column:1/-1; } .foot-legal { margin-left:0; } }
</style>
