---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, sms } from '../data/business';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <section class="band band-ink notfound">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="display">That page is not here.</h1>
      <p class="lede">
        It may never have existed, or it may have moved. Either way, here is where
        everything actually is.
      </p>

      <ul class="links">
        <li><a href="/">Home</a></li>
        <li><a href="/services">Services &amp; pricing</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact#estimate">Contact &amp; free estimate</a></li>
      </ul>

      <p class="actions notfound-actions">
        <a class="btn btn-primary" href="/contact#estimate">Request an estimate</a>
        <a class="btn btn-ghost" href={sms}>Text {business.phone.display}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .notfound .eyebrow {
    color: var(--amber);
  }
  .notfound h1 {
    color: var(--paper);
    font-size: clamp(2.25rem, 5vw, var(--s8));
    margin-block: 0.7rem 1rem;
  }
  .notfound .lede {
    color: var(--slate-ltr);
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.75rem;
  }
  .links a {
    color: var(--slate-ltr);
    text-decoration: none;
    border-bottom: 2px solid var(--hair-dark);
    padding-bottom: 0.15rem;
  }
  .links a:hover {
    color: var(--paper);
    border-bottom-color: var(--amber);
  }
  .notfound-actions {
    margin-top: 2rem;
  }
</style>
