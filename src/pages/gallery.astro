---
import BaseLayout from '../layouts/BaseLayout.astro';
import CloserCta from '../components/CloserCta.astro';
import { business } from '../data/business';

/*
 * Honest empty state. There are no completed jobs yet, so there is nothing to
 * show — and stock concrete or an example project here would be a claim about
 * work the business has not done. When real before/after pairs exist, replace
 * the "First jobs" block with the gallery grid; the standard section below
 * already describes the bar those photographs have to meet.
 *
 * This note lives in frontmatter rather than an HTML comment so it does not ship
 * to the browser.
 */
---

<BaseLayout
  title="Project gallery"
  description="How SELI Pressure Washing documents concrete cleaning results in Duncan, Oklahoma."
>
  <section class="band band-ink page-head">
    <div class="wrap">
      <p class="eyebrow">Project gallery</p>
      <h1 class="display">The work.<br />In its own light.</h1>
      <p class="lede">
        A place for real concrete cleaning results. Same surface, same angle,
        and a clear account of the work.
      </p>
    </div>
  </section>

  <section class="band band-paper">
    <div class="wrap">
      <div class="empty rise">
        <p class="eyebrow">First jobs</p>
        <h2 class="display">Real projects.<br />Coming when there’s work to show.</h2>
        <p>
          No completed-job photos are available yet. Future projects will be
          photographed by {business.name} and shared with customer permission.
          The homepage’s interactive concrete textures are illustrative, not our completed work.
        </p>
        <a class="text-action" href="/#services">Explore our concrete services</a>
      </div>
    </div>
  </section>

  <section class="band band-mist">
    <div class="wrap">
      <div class="band-head rise">
        <div>
          <p class="eyebrow">Our standard</p>
          <h2 class="display">A fair before-and-after comparison.</h2>
        </div>
        <p class="band-head-aside">
          The same surface, camera position, light, and visit. No filters,
          retouching, or somebody else's work.
        </p>
      </div>

      <ol class="rules rise">
        <li>
          <h3>One surface, photographed twice</h3>
          <p>The frames line up so the change is easy to judge.</p>
        </li>
        <li>
          <h3>Same visit and conditions</h3>
          <p>Lighting and weather do not get to improve the result.</p>
        </li>
        <li>
          <h3>No filters or retouching</h3>
          <p>Only matching crops are used to align a genuine pair.</p>
        </li>
        <li>
          <h3>Useful project details</h3>
          <p>Surface, approximate size, treatment, and time are included.</p>
        </li>
      </ol>

    </div>
  </section>

  <CloserCta heading="See what your concrete can look like." />
</BaseLayout>

<style>
  .page-head .eyebrow {
    color: var(--amber);
  }
  .page-head h1 {
    max-width: 24ch;
    margin-block: 0.7rem 1rem;
    color: var(--paper);
    font-size: clamp(2.1rem, 4.6vw, var(--s8));
  }
  .page-head .lede {
    color: var(--slate-ltr);
  }
  .rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    list-style: none;
    counter-reset: rule;
  }
  .rules li {
    counter-increment: rule;
    padding-top: 1rem;
    border-top: 2px solid var(--hair-light);
  }
  .rules li::before {
    content: counter(rule, decimal-leading-zero);
    display: block;
    margin-bottom: 0.5rem;
    color: var(--slate-dk);
    font-family: var(--display);
    font-size: var(--s5);
    font-weight: 600;
  }
  .rules h3 {
    margin-bottom: 0.4rem;
    color: var(--ink);
    font-family: var(--display);
    font-size: var(--s5);
    font-weight: 600;
  }
  .rules p {
    color: var(--slate);
    font-size: var(--s2);
  }
  .gallery-actions {
    margin-top: 2rem;
  }
  .empty {
    max-width: 70ch;
    border-left: 3px solid var(--wet);
    padding-left: clamp(1rem, 3vw, 2rem);
  }
  .empty .eyebrow {
    color: var(--slate-dk);
  }
  .empty h2 {
    margin-block: 0.6rem 1rem;
    color: var(--ink);
    font-size: clamp(1.8rem, 3.4vw, var(--s7));
  }
  .empty p {
    color: var(--slate);
  }
  .empty-cta {
    margin-top: 1.75rem;
  }
  .empty .text-action { margin-top:1.4rem; }
  @media(max-width:560px) { .rules { grid-template-columns:1fr; } }
</style>
