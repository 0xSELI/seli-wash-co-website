---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealHero from '../components/RevealHero.astro';
import DrivewayPricing from '../components/DrivewayPricing.astro';
import FaqList from '../components/FaqList.astro';
import DuncanMap from '../components/DuncanMap.astro';
import CloserCta from '../components/CloserCta.astro';
import { business, jobMinimumSummary } from '../data/business';
import { coreServices, customQuoteServices } from '../data/services';
import { faqPreview } from '../data/faqs';
---
<BaseLayout title="Concrete cleaning in Duncan, Oklahoma" description={business.shortDescription}>
  <RevealHero />
  <section class="band band-paper" id="pricing"><div class="wrap"><DrivewayPricing /></div></section>
  <section class="band band-mist" id="services">
    <div class="wrap service-layout">
      <div class="service-heading rise"><p class="eyebrow">What we clean</p><h2 class="display">From the driveway<br />to the doorstep.</h2><p>Focused care for ordinary concrete. Choose your surface to see what’s included.</p><a class="text-action" href="/services#not-offered">Check surface requirements</a></div>
      <div class="service-list rise">
        {coreServices.map((s,i) => <a href={`/services#${s.slug}`} class="service-link"><span class="service-no" aria-hidden="true">0{i+1}</span><div><h3>{s.name}</h3><p>{s.slug === 'driveways' ? 'Introductory pricing — see the calculator above.' : s.blurb}</p><span class="service-price">{s.price}</span></div><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>)}
        <p class="service-footnote">{jobMinimumSummary} Additional surfaces and specialty stain treatments are quoted separately. Final prices are confirmed before work.</p>
      </div>
    </div>
    <div class="wrap"><div class="property-line rise"><h3>Looking after a property?</h3><p>{customQuoteServices.map(s => s.name).join(' and ')} are quoted individually.</p><a class="text-action" href="/services#property-managers">Property services</a></div></div>
  </section>
  <section class="band band-ink" id="process">
    <div class="wrap">
      <div class="band-head rise"><div><p class="eyebrow">How it works</p><h2 class="display">A conversation.<br />Then a clean.</h2></div><p class="band-head-aside">No automatic booking. Just the details, an agreed price, and a day that works.</p></div>
      <ol class="steps rise">
        <li><span class="step-n">01</span><h3>Send the details</h3><p>Text your address, the surface, and a photo if you have one. Our guided form can prepare the message; you send it from your messaging app.</p></li>
        <li><span class="step-n">02</span><h3>Agree the price</h3><p>We discuss the surface and access, check water and power, then confirm your price and day with you.</p></li>
        <li><span class="step-n">03</span><h3>Refresh the concrete</h3><p>We connect to your outdoor spigot and GFCI outlet, clean the agreed area, and leave the site rinsed and clear.</p></li>
      </ol>
    </div>
  </section>
  <section class="band band-paper" id="area"><div class="wrap local-grid">
    <div class="local-story rise"><p class="eyebrow">Where we work</p><h2 class="display">Local work.<br />Straight answers.</h2><p>Based in {business.area.label}. Outside Duncan? Ask us about your address. Travel is ${business.area.travelChargePerMile} per additional mile outside the normal service area, included in your quote.</p><div class="local-hours"><strong>{business.hours.workDaysShort}</strong><span>Jobs 9am–6pm · Weekends by request</span></div><DuncanMap compact /></div>
    <div class="local-faq rise" id="faq"><h2 class="display">Before we arrive.</h2><p>We need an outdoor water spigot and a working GFCI outlet within about {business.equipment.hoseFeet} feet of the area.</p><FaqList items={faqPreview.filter(f => !f.q.includes('introductory driveway'))} /><a class="text-action" href="/contact#faq">All questions</a></div>
  </div></section>
  <CloserCta />
</BaseLayout>
<style>
  .service-layout { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:clamp(2rem,6vw,5rem); }
  .service-heading h2,.local-story h2 { color:var(--ink); font-size:clamp(2rem,3.5vw,3rem); margin-block:.7rem 1.3rem; }
  .service-heading p:not(.eyebrow) { max-width:33ch; margin-bottom:1rem; }
  .eyebrow { color:var(--slate-dk); }
  .band-ink .eyebrow { color:var(--wet); }
  .service-link { display:grid; grid-template-columns:26px minmax(0,1fr) 22px; align-items:start; gap:1rem; text-decoration:none; border-top:1px solid var(--hair-light); padding:1.4rem 0; transition:background var(--dur-fast),padding var(--dur-fast); }
  .service-link:hover { background:var(--paper); padding-inline:.7rem; }
  .service-no { color:var(--slate); font:500 .8rem/2 var(--display); }
  .service-link h3 { color:var(--ink); font:600 1.5rem/1.2 var(--display); margin-bottom:.4rem; }
  .service-link p { color:var(--slate); font-size:.875rem; max-width:47ch; }
  .service-price { display:block; margin-top:.7rem; color:var(--ink); font-weight:650; font-size:.9rem; }
  .service-footnote { font-size:.8rem; color:var(--slate); }
  .property-line { border-top:1px solid var(--hair-light); margin-top:3rem; padding-top:1.5rem; display:flex; align-items:center; gap:1rem 2rem; flex-wrap:wrap; }
  .property-line h3 { font:600 1.25rem var(--display); color:var(--ink); }
  .property-line p { flex:1; font-size:.875rem; min-width:220px; }
  .steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); list-style:none; gap:2.5rem; }
  .steps li + li { border-left:1px solid var(--hair-dark); padding-left:2rem; }
  .step-n { width:48px; height:48px; display:grid; place-items:center; color:var(--ink); background:var(--wet); border-radius:50%; font:600 1.2rem var(--display); margin-bottom:1rem; }
  .steps h3 { font:600 1.55rem/1.2 var(--display); color:var(--paper); margin-bottom:.7rem; }
  .steps p { font-size:.95rem; color:var(--slate-ltr); }
  .local-grid { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:clamp(2rem,7vw,6rem); align-items:start; }
  .local-story>p { max-width:46ch; }
  .local-hours { display:flex; flex-direction:column; margin-block:1.5rem; border-left:3px solid var(--wet); padding-left:1rem; }
  .local-hours strong { color:var(--ink); }
  .local-hours span { font-size:.8rem; }
  .local-story :global(.map) { max-width:360px; }
  .local-faq>h2 { font-size:2rem; color:var(--ink); margin-block:.6rem 1rem; }
  .local-faq>p { margin-bottom:1.2rem; }
  .local-faq>.text-action { margin-top:1.4rem; }
  @media(max-width:760px) { .service-layout,.local-grid { grid-template-columns:1fr; } .steps { grid-template-columns:1fr; gap:1.5rem; } .steps li + li { border-left:0; border-top:1px solid var(--hair-dark); padding:1.5rem 0 0; } .steps li { display:grid; grid-template-columns:48px minmax(0,1fr); gap:0 1rem; } .step-n { grid-row:span 2; } .steps h3 { align-self:center; } .steps p { grid-column:2; } }
</style>
